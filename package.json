{
  "name": "escala-acolitos-backend",
  "version": "1.0.0",
  "description": "Backend para o sistema de gerenciamento de escala de acólitos",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "deploy": "npm run build && gcloud app deploy"
  },
  "keywords": [
    "acolitos",
    "escala",
    "igreja",
    "node",
    "express",
    "firebase"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/mongoose": "^5.11.96",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.18.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
